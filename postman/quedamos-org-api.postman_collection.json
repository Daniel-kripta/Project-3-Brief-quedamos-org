    "name": "quedamos-api",
    "description": "API REST de quedamos.org — plataforma de eventos sociales en Canarias.\n\n**Instrucciones rápidas:**\n1. Importa esta colección y el entorno `quedamos-local`\n2. Selecciona el entorno `quedamos-local`\n3. Ejecuta **Login** — el token se guarda automáticamente\n4. Ya puedes usar el resto de requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "54340373",
    "_collection_link": "https://go.postman.co/collection/54340373-a17f8ad4-acb7-4e84-ba3c-45a87a6178d6?source=collection_link"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nueva Persona\",\n  \"email\": \"nueva@example.ic\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{Railway_url}}/api/auth/register",
              "host": ["{{Railway_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.environment.set(\"token\", pm.response.json().token)"],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@quedamos.org\",\n  \"password\": \"quedamos2026\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{Railway_url}}/api/auth/login",
              "host": ["{{Railway_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
